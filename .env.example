# --- LLM provider ---
# Which provider to use for answer generation: anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic (default)
ANTHROPIC_API_KEY=sk-ant-...
GENERATION_MODEL=claude-sonnet-4-6
# Cheaper option for high volume: claude-haiku-4-5-20251001

# OpenAI (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# GENERATION_MODEL=gpt-4o-mini

# --- Embeddings (local, free, no API key) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
USE_GRAPH_RETRIEVAL=true
GRAPH_EXPANSION=2

# --- Paths ---
DATA_DIR=data/sample_docs
INDEX_DIR=storage

# --- Generation ---
MAX_TOKENS=1024
